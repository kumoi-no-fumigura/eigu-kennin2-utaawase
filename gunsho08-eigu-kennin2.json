 "poems": [
  {
   "seq": "1",
   "text": "橫雲のたな引山の郭公なく一聲にしらみ出ぬる",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "うちつけに物かなしきは郭公雲間にまよふ曉のこゑ",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "時鳥夜半にまたれて有明のねられぬ月に雲路行聲",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "郭公雲のいつくに有明のつきせぬ聲の名殘なるらん",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "今こんとたのめやをきしほとゝきす月そ待いつる有明の聲",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "尋ねつるかひも有明の郭公月にたひねの雲になくなり",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "郭公なく一聲のしのゝめに月のゆくゑもあかぬ空かな",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "月にゆくせきの旅人出ぬらし山に友なふ郭公かな",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "今はとやをちかへり鳴ほとゝきすをのか五月も有明の山",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "明はてはいたくな啼そ郭公またておきぬる人もこそきけ",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "五月雨に明やらぬ空のほとゝきすかさなる雲の空に鳴也",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "郭公なく程なくて有明の雲のいつくに聲うつるらむ",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "郭公よはも名殘や忍ふらんなを明やらぬ一聲の空",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "明るまの雲の外にそ聞ゆなるまた里なれぬ山ほとゝきす",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "またれつる心のほとも郭公見よとや來なく明たかの空",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "ほとゝきす鳴行なみたのこしけりわかたまくらの明方の空",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "時鳥有明の月の入かたに山のはいつる夜半の一こゑ",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "ほとゝきすあかぬ名殘も有明の月をはなれて遠さかる聲",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "有明の月こそ雲の空ならめ聲もおほろのほとゝきす哉",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "あはれいかゝおりしもきつる郭公雲間の月の有明の空",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "郭公名殘はさてもおもほえてあかていく野のあかつきの聲",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "郭公なくや五月をかそふれは今いくよかは有明のこゑ",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "五月山おりはへてなけ郭公夏もふけ行ありあけの空",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "またよひの月そ待つるほとゝきすなく一聲に有明のそら",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "せきすへぬならひはなそや夏のよの山ほとゝきす入方の月",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "夏山のしかにつけこせ松の風尾上にいまは秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "高砂のおのへの暮にながむれは秋風いそく松のむら立",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "松にふく風になかるゝたつた川木葉はかりや秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "暮行は風は秋なるふるさとに色こそ見えね松の下草",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "たゝならぬ夕まくれ哉思ふにも松ふく風の音は身にしむ",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "涼しさはいつくと風のわかねとも野中の松の夕暮の聲",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "柴の戶にさすやこのまの夕つくひ影も涼しき軒の松風",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "木のまより風も涼しく成ぬるか月のみいまはもりの下風",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "山をいつる月のかつらに通ふらしたもといなるゝ松の下風",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "今さらに夏やなからん一聲の秋にそかよふ松の夕風",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "木末よる日影やにしに成ぬらん凉しさまさる松の風哉",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "松風は〓とのねにこそきこゆなれ秋にもかよふ夕間暮かな",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "たかさこの尾上の松の夕すゝみしかなきぬへき風の音哉",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "月をこそかはらすすめと松山の松よりこえて秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "夕まくれ秋とや今はまつの風すゝしくかよふ蟬の羽ころも",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "さらねとも夕波すゝしまたきより秋となつけそ磯の松風",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "山かけやむすふ岩井の水の面に秋の浪たつ松の夕風",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "暮ぬるか夏の空さへをしほ山松よりつたふ風の下かけ",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "夕かせの枝しつかなる松かけにかねてしらるゝ千代の秋哉",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "夕附日さすや梢をよそにみて山かけすゝし庭の松かせ",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "大かたにきかまし風の夕さへわか身ひとつの松の音哉",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "さをしかや猶秋まてと忍ふらん夕はいまも松にふく風",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "ゆふまくれ岩井の水は結はねと夏なきとしの松風の聲",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "風もよし夕日をさへて松たてる夏をいとはゝ住のえの濵",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "松風にこたふおのへの鐘の聲すゝしくひゝく入相の空",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "月すめはいまた夏なる夕すゝみ秋とも吹か松の下かせ",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "これまてもさそな昔のならひ哉待夜いまはのかたしきの袖",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "忘れしの行末かはるけふまてもあれはあふ夜を猶賴みつゝ",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "忘るなよわすれしとこそ契りしをたか僞りになせとかは思ふ",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "今こんといひし計に夜比へてむなしき床に有明の月",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "淺ましやかへてしやまは山城のゐての玉水何むすひけん",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "たれとまた別れもやらてなかむらん月も出ぬとおしみし物を",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "ふみ分し庭はあさちに跡たえてはらひし夜半の露は袂に",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "せめてかく物思へとのあまりにや忘るなとたに契り置けん",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "わすらるゝ身をしる袖の村雨につれなく山の月は出にけり",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "いはさりきたのめてとはぬ夜な〓〓をこれは情そ後忍へとは",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "夢かとよ見し面影も契りしも忘れすなからうつゝならねは",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "里はあれぬむなしき床のあたりまて身はならはしの秋風そ吹",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "かれはつるうつゝこそあらめいかにせん夢も冬野の淺茅原哉",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "我戀は雪ふりうつむ小萩原うつろふ露を恨みし物を",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "見すもあらすみもせぬ程の詠めたにさこそ昔は日を暮しけれ",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "なからふとまたしもあはし世中のいきて歎かぬ我身なりとも",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "忘れしとたのめし事と賴むやと見えんとさへ今は悔しき",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "逢みての後こそ人もつらけれはたゝ我からのれをのみそなく",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "かたみとてまなくもちるかしかすかに馴しなこりの袖の白露",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "かたみとてほのふみ分し跡もなし今は昔の庭の荻原",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "中〓〓にとまるにつけてつらき哉わすれかたみの袖の移り香",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
